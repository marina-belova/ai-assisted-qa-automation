# Run tests
# Required to clone the repo and run Playwright. playwright.config.ts loads .env.
# DIDAXIS_URL is the application base URL.
DIDAXIS_URL=https://example.com
# DIDAXIS_EMAIL is the login email. LoginPage and the auth setup read it.
DIDAXIS_EMAIL=user@example.com
# DIDAXIS_PASSWORD is the login password. Never commit a real password.
DIDAXIS_PASSWORD=your-password
# DIDAXIS_API_TOKEN is the Bearer token used for program cleanup.
DIDAXIS_API_TOKEN=your-api-token
# DIDAXIS_ALT_EMAIL is optional. No current spec reads it. Reserved for permission probes.
DIDAXIS_ALT_EMAIL=alt-user@example.com
# DIDAXIS_ALT_PASSWORD is optional. No current spec reads it. Reserved for permission probes.
DIDAXIS_ALT_PASSWORD=your-alt-password

# Agent / CI
# Not required for npx playwright test. Used by .github/workflows/test-generation.yml
# and by Atlassian MCP settings in Cursor.
# CURSOR_API_KEY authenticates the headless agent in the test-generation workflow.
CURSOR_API_KEY=your-cursor-api-key
# ATLASSIAN_API_TOKEN is the Jira API token for Backlog Mode.
ATLASSIAN_API_TOKEN=your-atlassian-api-token
# ATLASSIAN_BASE_URL is the Jira site origin, with no trailing path.
ATLASSIAN_BASE_URL=https://example.atlassian.net
# ATLASSIAN_EMAIL is the Atlassian account email paired with the API token.
ATLASSIAN_EMAIL=user@example.com
